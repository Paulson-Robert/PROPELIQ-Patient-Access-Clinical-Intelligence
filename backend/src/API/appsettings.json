{
  "ConnectionStrings": {
    "DefaultConnection": "",
    "Redis": ""
  },
  "DocumentStorage": {
    "BasePath": "App_Data/documents",
    "MaxFileSizeBytes": 26214400,
    "CompleteUploadsImmediately": true
  },
  "ClamAV": {
    "Host": "localhost",
    "Port": 3310,
    "ScanTimeoutSeconds": 30
  },
  "AiIntake": {
    "ApiKey": "",
    "Model": "gpt-4o",
    "CompletionsUrl": "https://api.openai.com/v1/chat/completions",
    "TimeoutSeconds": 30,
    "MaxResponseTokens": 500
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information",
        "System": "Warning",
        "Hangfire": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/propeliq-.log",
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "fileSizeLimitBytes": 104857600,
          "rollOnFileSizeLimit": true
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ]
  },
  "Sentry": {
    "Dsn": "",
    "SendDefaultPii": false,
    "MaxRequestBodySize": "Small",
    "MinimumBreadcrumbLevel": "Information",
    "MinimumEventLevel": "Warning",
    "AttachStacktrace": true,
    "TracesSampleRate": 0.1
  },
  "HealthChecks": {
    "TimeoutSeconds": 5
  },
  "RateLimiting": {
    "Limit": 100,
    "WindowSeconds": 60
  },
  "Authentication": {
    "JwtIssuer": "PropelIQ.Auth",
    "JwtAudience": "PropelIQ.Client",
    "JwtSigningKey": "CHANGE_THIS_TO_A_STRONG_MIN_32_CHAR_SECRET",
    "AccessTokenMinutes": 15,
    "VerificationTokenMinutes": 30,
    "LoginRedirectPath": "/auth/login"
  },
  "EmailDelivery": {
    "Enabled": false,
    "Provider": "smtp",
    "FromAddress": "",
    "FromName": "PropelIQ",
    "SmtpHost": "",
    "SmtpPort": 587,
    "SmtpUsername": "",
    "SmtpPassword": "",
    "UseStartTls": true
  },
  "GoogleCalendar": {
    "ClientId": "",
    "ClientSecret": "",
    "RedirectUri": ""
  },
  "ExtractionThresholds": {
    "AutoAcceptThreshold": 0.9,
    "ReviewThreshold": 0.7
  }
}
